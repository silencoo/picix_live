# 复制为 .env 后填写；不要提交真实的 .env。
PICIX_BOT_TOKEN=YOUR_BOT_TOKEN

# 可选。通常由 Bot 续期后写入 unlock_data/authorization.json。
# PICIX_AUTHORIZATION=YOUR_PICIX_AUTHORIZATION

# 多个用户 ID 使用英文逗号分隔。
PICIX_ALLOWED_USER_IDS=
PICIX_NOTIFICATION_THRESHOLD=10
PICIX_CHECK_INTERVAL=3600
PICIX_AUTO_UNLOCK_HOUR=9
PICIX_AUTO_UNLOCK_MINUTE=0

# 积分最大化策略。自动购买会真实扣除积分；设为 false 可只生成计划。
PICIX_AUTO_OPTIMIZE=true
PICIX_AUTO_PURCHASE=true
PICIX_TIMEZONE=Asia/Shanghai
PICIX_MINIMUM_MONTHLY_SPEND=450
PICIX_PACKAGE_GOOD_ID=1
PICIX_PACKAGE_PRICE=450
PICIX_PACKAGE_QUOTA=30
# 低消按历史流水表现为滚动30天周期；第25天开始兜底。
PICIX_SPEND_CYCLE_DAYS=30
PICIX_SPEND_TRIGGER_DAY=25
PICIX_POINTS_RESERVE=0
PICIX_MAX_AUTO_PURCHASES=2
PICIX_MAX_AUTO_UNLOCKS=50
